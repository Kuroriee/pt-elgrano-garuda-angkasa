# Serve Markdown to agents that ask for it (Accept: text/markdown)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Accept} text/markdown
  RewriteRule ^$ /index.md [L]
</IfModule>

AddDefaultCharset UTF-8
AddType "text/markdown; charset=UTF-8" .md
AddType "text/plain; charset=UTF-8" .txt

# Mark the homepage request
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(index\.html)?$" IS_HOME=1
</IfModule>

# RFC 8288 Link header + Vary on the homepage (no inner quotes on purpose)
<IfModule mod_headers.c>
  Header set Link "</llms.txt>; rel=describedby, </index.md>; rel=alternate" env=IS_HOME
  Header append Vary Accept env=IS_HOME
</IfModule>